<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="90dp"
    android:viewportWidth="400"
    android:viewportHeight="180">
  <path
      android:pathData="M0,0h400v180h-400z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:startX="0"
          android:startY="0"
          android:endX="400"
          android:endY="180"
          android:type="linear">
        <item android:offset="0" android:color="#FF00668B"/>
        <item android:offset="0.6" android:color="#FF004C6A"/>
        <item android:offset="1" android:color="#FF00283A"/>
      </gradient>
    </aapt:attr>
  </path>
  <!-- Background clinic desk & window lines -->
  <path
      android:pathData="M300,20 L380,20 L380,100 L300,100 Z"
      android:strokeWidth="2"
      android:strokeColor="#33FFFFFF"/>
  <path
      android:pathData="M340,20 L340,100 M300,60 L380,60"
      android:strokeWidth="1.5"
      android:strokeColor="#33FFFFFF"/>
  <!-- Stethoscope / Cross Watermark -->
  <path
      android:pathData="M320,130 C320,110 340,110 340,130 L340,150 C340,160 330,165 320,165 C310,165 300,160 300,150 Z"
      android:strokeWidth="3"
      android:strokeColor="#22FFFFFF"
      android:fillColor="#00000000"/>
  <!-- Medical Cross Badge -->
  <path
      android:pathData="M50,40 h20 v-20 h20 v20 h20 v20 h-20 v20 h-20 v-20 h-20 z"
      android:fillColor="#33FFFFFF"/>
  <!-- Subtle Heartbeat line -->
  <path
      android:pathData="M20,140 L80,140 L90,120 L105,160 L120,110 L135,145 L145,140 L220,140"
      android:strokeWidth="2.5"
      android:strokeColor="#447AD0FF"
      android:fillColor="#00000000"/>
</vector>
